{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://madcore.rpg/schema/gamedata",
    "title": "MadCore RPG GameData Schema",
    "description": "Master validation schema for all GameData JSON files in the MadCore RPG engine.",
    "definitions": {
        "modifier": {
            "$id": "#/definitions/modifier",
            "description": "A single stat modification instruction. Evaluates an expression (expr). MUST NOT use 'val' or 'roll'.",
            "type": "object",
            "required": [
                "target",
                "op",
                "expr"
            ],
            "additionalProperties": false,
            "properties": {
                "target": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The stat ID to target."
                },
                "op": {
                    "$ref": "#/definitions/op_enum"
                },
                "expr": {
                    "type": "string",
                    "minLength": 1,
                    "description": "An expression string to evaluate (e.g. '5' or 'con * 2d6'). Use 'expr', never 'val' or 'roll'."
                },
                "weight": {
                    "type": "number",
                    "description": "Optional weight for adaptation rules."
                },
                "damage_type": {
                    "type": "string",
                    "description": "Optional: damage category (e.g. Physical, Fire)."
                },
                "condition": {
                    "type": "string",
                    "description": "Optional: simple string-based condition for activation (e.g., 'Underwater')."
                },
                "conditions": {
                    "$ref": "#/definitions/conditions_object"
                }
            }
        },
        "mods_array": {
            "$id": "#/definitions/mods_array",
            "description": "An array of modifier instructions.",
            "type": "array",
            "items": {
                "$ref": "#/definitions/modifier"
            }
        },
        "op_enum": {
            "$id": "#/definitions/op_enum",
            "description": "The operation to perform. Must be one of the six valid engine operations.",
            "type": "string",
            "enum": [
                "add",
                "subtract",
                "multiply",
                "divide",
                "set",
                "apply"
            ]
        },
        "conditions_object": {
            "$id": "#/definitions/conditions_object",
            "description": "An optional object housing conditional trigger logic. All conditional logic MUST be inside this object.",
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "base_stat": {
            "$id": "#/definitions/base_stat",
            "description": "A Raw stat definition blueprint (e.g. str, dex, con). statType must be 'Raw'.",
            "type": "object",
            "required": [
                "id",
                "displayName",
                "description",
                "spriteIcon",
                "baseValue",
                "statType"
            ],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "displayName": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                },
                "spriteIcon": {
                    "type": "string"
                },
                "baseValue": {
                    "type": "number"
                },
                "statType": {
                    "type": "string",
                    "const": "Raw"
                }
            }
        },
        "derived_stat": {
            "$id": "#/definitions/derived_stat",
            "description": "A Potential stat definition with a calculation formula (e.g. hp_max, speed, ac). MUST NOT have 'statType' or 'baseValue'.",
            "type": "object",
            "required": [
                "description",
                "formula"
            ],
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "formula": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A formula string referencing stat IDs. Supports +,-,*,/ and Max()/Min() functions."
                }
            }
        },
        "component_part": {
            "$id": "#/definitions/component_part",
            "description": "A body part / appendage entry with optional tags, granted skills, traversal modes, and stat mods.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Descriptive tags for this part."
                },
                "traversal": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Movement modes granted by this part."
                },
                "grants_skills": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Skill names this part grants."
                },
                "mods": {
                    "$ref": "#/definitions/mods_array"
                }
            }
        },
        "skill_entry": {
            "$id": "#/definitions/skill_entry",
            "description": "A skill definition with type, range, description, and optional mods.",
            "type": "object",
            "required": [
                "description",
                "type",
                "range",
                "mods"
            ],
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "Attack",
                        "Utility",
                        "Effect",
                        "Communication",
                        "Movement",
                        "Passive",
                        "Sense",
                        "Skill",
                        "Reaction",
                        "Action"
                    ],
                    "description": "Broad category of the skill."
                },
                "range": {
                    "type": "string",
                    "description": "Range descriptor (e.g. Melee, 10ft, Audible, 20/60)."
                },
                "mods": {
                    "$ref": "#/definitions/mods_array"
                }
            }
        },
        "mechanic_entry": {
            "$id": "#/definitions/mechanic_entry",
            "description": "A mechanics entry (e.g. status_effect, biological_upgrade) with optional conditions, mods, and granted skills.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "conditions": {
                    "$ref": "#/definitions/conditions_object"
                },
                "mods": {
                    "$ref": "#/definitions/mods_array"
                },
                "grants_skills": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "operation_entry": {
            "$id": "#/definitions/operation_entry",
            "description": "An operation definition entry (from operations.json).",
            "type": "object",
            "required": [
                "description"
            ],
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                }
            }
        },
        "consumable_category_entry": {
            "$id": "#/definitions/consumable_category_entry",
            "type": "object",
            "additionalProperties": true
        },
        "prefix_entry": {
            "$id": "#/definitions/prefix_entry",
            "description": "A name prefix entry with optional mods and conditions.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "conditions": {
                    "$ref": "#/definitions/conditions_object"
                },
                "mods": {
                    "$ref": "#/definitions/mods_array"
                },
                "grants_skills": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "biome_entry": {
            "$id": "#/definitions/biome_entry",
            "description": "A biome definition entry.",
            "type": "object",
            "required": [
                "id",
                "name",
                "description",
                "terrain_flags",
                "climate",
                "adaptation_rules",
                "environmental_hazards",
                "sensory_mods",
                "resource_tags"
            ],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "terrain_flags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "climate": {
                    "type": "object",
                    "properties": {
                        "base_temp": {
                            "type": "string"
                        },
                        "weather": {
                            "type": "string"
                        },
                        "night_temp": {
                            "type": "string"
                        }
                    }
                },
                "adaptation_rules": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "skills": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "id": {
                                        "type": "string"
                                    },
                                    "weight": {
                                        "type": "number"
                                    }
                                },
                                "required": [
                                    "id",
                                    "weight"
                                ]
                            }
                        },
                        "mods": {
                            "$ref": "#/definitions/mods_array"
                        }
                    }
                },
                "environmental_hazards": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "payload_id": {
                                "type": "string"
                            },
                            "chance_per_tick": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "payload_id",
                            "chance_per_tick"
                        ]
                    }
                },
                "sensory_mods": {
                    "$ref": "#/definitions/mods_array"
                },
                "resource_tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "type": "object",
    "patternProperties": {
        "^.*$": {
            "description": "Any top-level key is a named entry. Each entry must match one of the known MadCore RPG data structures.",
            "anyOf": [
                {
                    "$ref": "#/definitions/base_stat"
                },
                {
                    "$ref": "#/definitions/derived_stat"
                },
                {
                    "$ref": "#/definitions/component_part"
                },
                {
                    "$ref": "#/definitions/skill_entry"
                },
                {
                    "$ref": "#/definitions/mechanic_entry"
                },
                {
                    "$ref": "#/definitions/operation_entry"
                },
                {
                    "$ref": "#/definitions/prefix_entry"
                },
                {
                    "$ref": "#/definitions/consumable_category_entry"
                },
                {
                    "$ref": "#/definitions/biome_entry"
                }
            ]
        }
    }
}