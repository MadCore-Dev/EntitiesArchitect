{
    "Aggressive_Brawler": {
        "description": "Fights to the death. Charges the closest target and spams melee/natural attacks.",
        "tree": {
            "type": "Selector",
            "nodes": [
                {
                    "type": "Sequence",
                    "description": "Desperation attack when near death",
                    "conditions": [
                        "self.hp_percent < 0.2"
                    ],
                    "action": "Select_Skill(types:['Melee_Attack', 'Grapple'], priority:'Highest_Damage')"
                },
                {
                    "type": "Sequence",
                    "description": "Close the gap if target is far",
                    "conditions": [
                        "distance_to_target > 1"
                    ],
                    "action": "Move_Towards_Target"
                },
                {
                    "type": "Action",
                    "description": "Default melee combat",
                    "action": "Select_Skill(types:['Melee_Attack', 'Natural_Weapon'], priority:'Random')"
                }
            ]
        }
    },
    "Cautious_Skirmisher": {
        "description": "Hit-and-run tactics. Buffs itself when far, retreats when wounded.",
        "tree": {
            "type": "Selector",
            "nodes": [
                {
                    "type": "Sequence",
                    "description": "Retreat if wounded",
                    "conditions": [
                        "self.hp_percent < 0.4"
                    ],
                    "action": "Move_Away_From_Target"
                },
                {
                    "type": "Sequence",
                    "description": "Buff if target is far",
                    "conditions": [
                        "distance_to_target > 2",
                        "!self.has_active_buff"
                    ],
                    "action": "Select_Skill(types:['Enhancement', 'Stance'], priority:'Random')"
                },
                {
                    "type": "Sequence",
                    "description": "Attack from safe distance",
                    "conditions": [
                        "distance_to_target <= 3",
                        "distance_to_target > 1"
                    ],
                    "action": "Select_Skill(types:['Ranged_Attack', 'Movement'], priority:'Random')"
                },
                {
                    "type": "Action",
                    "description": "Fallback melee",
                    "action": "Select_Skill(types:['Melee_Attack'], priority:'Lowest_Stamina')"
                }
            ]
        }
    },
    "Apex_Predator": {
        "description": "Locks down the target to prevent escape before executing them.",
        "tree": {
            "type": "Selector",
            "nodes": [
                {
                    "type": "Sequence",
                    "description": "Prevent escape if target tries to flee",
                    "conditions": [
                        "target.has_combat_tag('Fleeing') || distance_to_target > 1"
                    ],
                    "action": "Select_Skill(types:['Movement', 'Grapple'], priority:'Highest_Chance')"
                },
                {
                    "type": "Sequence",
                    "description": "Lock down if in range but target isn't grappled",
                    "conditions": [
                        "distance_to_target == 1",
                        "!target.has_status('Grappled')"
                    ],
                    "action": "Select_Skill(types:['Grapple'], priority:'Random')"
                },
                {
                    "type": "Action",
                    "description": "Execute locked-down target",
                    "action": "Select_Skill(types:['Melee_Attack', 'Natural_Weapon'], priority:'Highest_Damage')"
                }
            ]
        }
    },
    "Pack_Hunter": {
        "description": "Coordinates with allies, flanking and alerting others.",
        "tree": {
            "type": "Selector",
            "nodes": [
                {
                    "type": "Sequence",
                    "description": "Alert pack if combat just started",
                    "conditions": [
                        "self.combat_turns == 0"
                    ],
                    "action": "Select_Skill(types:['Vocal'], priority:'Alert')"
                },
                {
                    "type": "Sequence",
                    "description": "Flank if ally is engaging",
                    "conditions": [
                        "target.is_engaged_by_ally"
                    ],
                    "action": "Move_To_Flank"
                },
                {
                    "type": "Sequence",
                    "description": "Pin down the target for the pack",
                    "conditions": [
                        "distance_to_target == 1"
                    ],
                    "action": "Select_Skill(types:['Grapple', 'Melee_Attack'], priority:'Random')"
                },
                {
                    "type": "Action",
                    "description": "Close distance",
                    "action": "Move_Towards_Target"
                }
            ]
        }
    }
}