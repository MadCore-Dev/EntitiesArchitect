{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Engine Server",
            "type": "shell",
            "command": "python3 tools/serve_engine.py",
            "isBackground": true,
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "focus": false
            },
            "problemMatcher": {
                "owner": "madcore-server",
                "pattern": {
                    "regexp": "^NEVER_MATCHES$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^MadCore Engine Server",
                    "endsPattern": "^MadCore Engine Server Running at"
                }
            }
        },
        {
            "label": "Open Simple Browser",
            "type": "shell",
            "command": "open 'antigravity://vscode.simple-browser/show?url=http%3A%2F%2Flocalhost%3A8000%2Findex.html'",
            "presentation": {
                "reveal": "never",
                "panel": "shared",
                "close": true
            },
            "problemMatcher": []
        },
        {
            "label": "🎮 Launch MadCore Editor",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Start Engine Server",
                "Open Simple Browser"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}