{
    "name": "madcore-dev-server",
    "displayName": "MadCore Dev Server",
    "description": "Multi-project local development server with network-wide access and QR codes",
    "version": "1.0.1",
    "publisher": "madcore",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "configuration": {
            "title": "MadCore Dev Server",
            "properties": {
                "madcore.defaultTitle": {
                    "type": "string",
                    "default": "Dev Server",
                    "description": "Default title for the dashboard when no config file is found."
                },
                "madcore.defaultThemeColor": {
                    "type": "string",
                    "default": "#3b82f6",
                    "description": "Default theme color for the dashboard."
                }
            }
        },
        "commands": [
            {
                "command": "madcore.launchServer",
                "title": "⚡ Open Dev Server Dashboard",
                "category": "MadCore"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "madcore-dev-server",
                    "title": "MadCore Dev Server",
                    "icon": "icon.svg"
                }
            ]
        },
        "views": {
            "madcore-dev-server": [
                {
                    "id": "madcore.serverView",
                    "name": "Dashboard",
                    "type": "webview",
                    "icon": "icon.svg"
                }
            ]
        }
    }
}