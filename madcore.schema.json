{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://madcore.rpg/schema/gamedata",
    "title": "MadCore RPG GameData Schema",
    "description": "Master validation schema for all GameData JSON files in the MadCore RPG engine.",
    "definitions": {
        "modifier_val": {
            "$id": "#/definitions/modifier_val",
            "description": "A modifier that uses a fixed value (number or string). MUST NOT use 'roll'. MUST NOT use the forbidden key 'value'.",
            "type": "object",
            "required": [
                "target",
                "op",
                "val"
            ],
            "additionalProperties": false,
            "properties": {
                "target": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The stat ID to target."
                },
                "op": {
                    "$ref": "#/definitions/op_enum"
                },
                "val": {
                    "oneOf": [
                        {
                            "type": "number"
                        },
                        {
                            "type": "string",
                            "minLength": 1
                        }
                    ],
                    "description": "The fixed value to apply. Use 'val', never 'value'."
                },
                "damage_type": {
                    "type": "string",
                    "description": "Optional: damage category (e.g. Physical, Fire)."
                },
                "conditions": {
                    "$ref": "#/definitions/conditions_object"
                }
            }
        },
        "modifier_roll": {
            "$id": "#/definitions/modifier_roll",
            "description": "A modifier that uses a dice roll expression. MUST NOT use 'val'. MUST NOT use the forbidden key 'value'.",
            "type": "object",
            "required": [
                "target",
                "op",
                "roll"
            ],
            "additionalProperties": false,
            "properties": {
                "target": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The stat ID to target."
                },
                "op": {
                    "$ref": "#/definitions/op_enum"
                },
                "roll": {
                    "type": "string",
                    "pattern": "^[0-9]+d?[0-9]*$",
                    "description": "Dice notation (e.g. '1d6', '2d8', '1'). Use 'roll', never 'value'."
                },
                "damage_type": {
                    "type": "string",
                    "description": "Optional: damage category (e.g. Physical, Fire)."
                },
                "conditions": {
                    "$ref": "#/definitions/conditions_object"
                }
            }
        },
        "modifier": {
            "$id": "#/definitions/modifier",
            "description": "A single stat modification instruction. Must use either 'val' (fixed) OR 'roll' (dice). NEVER 'value'.",
            "oneOf": [
                {
                    "$ref": "#/definitions/modifier_val"
                },
                {
                    "$ref": "#/definitions/modifier_roll"
                }
            ]
        },
        "mods_array": {
            "$id": "#/definitions/mods_array",
            "description": "An array of modifier instructions.",
            "type": "array",
            "items": {
                "$ref": "#/definitions/modifier"
            }
        },
        "op_enum": {
            "$id": "#/definitions/op_enum",
            "description": "The operation to perform. Must be one of the six valid engine operations.",
            "type": "string",
            "enum": [
                "add",
                "subtract",
                "multiply",
                "divide",
                "set",
                "apply"
            ],
            "errorMessage": "op must be one of: add, subtract, multiply, divide, set, apply"
        },
        "conditions_object": {
            "$id": "#/definitions/conditions_object",
            "description": "An optional object housing conditional trigger logic. All conditional logic MUST be inside this object.",
            "type": "object",
            "additionalProperties": {
                "type": "string"
            }
        },
        "base_stat": {
            "$id": "#/definitions/base_stat",
            "description": "A Raw stat definition blueprint (e.g. str, dex, con). statType must be 'Raw'.",
            "type": "object",
            "required": [
                "id",
                "displayName",
                "description",
                "spriteIcon",
                "baseValue",
                "statType"
            ],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "displayName": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string"
                },
                "spriteIcon": {
                    "type": "string"
                },
                "baseValue": {
                    "type": "number"
                },
                "statType": {
                    "type": "string",
                    "const": "Raw"
                }
            }
        },
        "derived_stat": {
            "$id": "#/definitions/derived_stat",
            "description": "A Potential stat definition with a calculation formula (e.g. hp_max, speed, ac). MUST NOT have 'statType' or 'baseValue'.",
            "type": "object",
            "required": [
                "description",
                "formula"
            ],
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "formula": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A formula string referencing stat IDs. Supports +,-,*,/ and Max()/Min() functions."
                }
            }
        },
        "component_part": {
            "$id": "#/definitions/component_part",
            "description": "A body part / appendage entry with optional tags, granted skills, traversal modes, and stat mods.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Descriptive tags for this part."
                },
                "traversal": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Movement modes granted by this part."
                },
                "grants_skills": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Skill names this part grants."
                },
                "mods": {
                    "$ref": "#/definitions/mods_array"
                }
            }
        },
        "skill_entry": {
            "$id": "#/definitions/skill_entry",
            "description": "A skill definition with type, range, description, and optional mods.",
            "type": "object",
            "required": [
                "description",
                "type",
                "range",
                "mods"
            ],
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "Attack",
                        "Utility",
                        "Effect",
                        "Communication",
                        "Movement",
                        "Passive",
                        "Sense",
                        "Skill",
                        "Reaction",
                        "Action"
                    ],
                    "description": "Broad category of the skill."
                },
                "range": {
                    "type": "string",
                    "description": "Range descriptor (e.g. Melee, 10ft, Audible, 20/60)."
                },
                "mods": {
                    "$ref": "#/definitions/mods_array"
                }
            }
        },
        "mechanic_entry": {
            "$id": "#/definitions/mechanic_entry",
            "description": "A mechanics entry (e.g. status_effect, biological_upgrade) with optional conditions, mods, and granted skills.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "conditions": {
                    "$ref": "#/definitions/conditions_object"
                },
                "mods": {
                    "$ref": "#/definitions/mods_array"
                },
                "grants_skills": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "operation_entry": {
            "$id": "#/definitions/operation_entry",
            "description": "An operation definition entry (from operations.json).",
            "type": "object",
            "required": [
                "description"
            ],
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                }
            }
        },
        "consumable_category_entry": {
            "$id": "#/definitions/consumable_category_entry",
            "type": "object",
            "additionalProperties": true
        },
        "prefix_entry": {
            "$id": "#/definitions/prefix_entry",
            "description": "A name prefix entry with optional mods and conditions.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "conditions": {
                    "$ref": "#/definitions/conditions_object"
                },
                "mods": {
                    "$ref": "#/definitions/mods_array"
                },
                "grants_skills": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "type": "object",
    "description": "All GameData files are dictionary-style objects. Each value matches one of the known entry types.",
    "patternProperties": {
        "^.*$": {
            "description": "Any top-level key is a named entry. Each entry must match one of the known MadCore RPG data structures.",
            "oneOf": [
                {
                    "$ref": "#/definitions/base_stat"
                },
                {
                    "$ref": "#/definitions/derived_stat"
                },
                {
                    "$ref": "#/definitions/component_part"
                },
                {
                    "$ref": "#/definitions/skill_entry"
                },
                {
                    "$ref": "#/definitions/mechanic_entry"
                },
                {
                    "$ref": "#/definitions/operation_entry"
                },
                {
                    "$ref": "#/definitions/prefix_entry"
                },
                {
                    "$ref": "#/definitions/consumable_category_entry"
                }
            ]
        }
    }
}